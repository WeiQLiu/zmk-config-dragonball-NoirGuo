#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    /* ==================================================================== */
    /* ===== [核心注入 1：高级功能定义] 完美对接你的 Layer 1/2/3 逻辑 ===== */
    /* ==================================================================== */
    behaviors {
        // 1. 用于 Layer 1：当进入或按住 Layer 1 时，轨迹球自动切换为滚轮
        ib_scroll: ib_scroll {
            compatible = "zmk,behavior-input-processor";
            #binding-cells = <0>;
            device = <&trackball>;
            processors = <&zip_xy_to_scroll_scaler 1 1>; // 坐标转滚轮，保持默认 1:1 速度
        };

        // 2. 用于 Layer 2：当进入 Layer 2 时，轨迹球开启加速模式（此处设为 2 倍速）
        ib_fast: ib_fast {
            compatible = "zmk,behavior-input-processor";
            #binding-cells = <0>;
            device = <&trackball>;
            processors = <&zip_xy_scaler 2 1>; // 2/1 = 2倍加速。如果想更快，可以改成 <3 1>
        };

        // 3. 用于 Layer 3：当你切到 Layer 3（自动狙击层）时，轨迹球自动减速精准定位
        ib_sniper: ib_sniper {
            compatible = "zmk,behavior-input-processor";
            #binding-cells = <0>;
            device = <&trackball>;
            processors = <&zip_xy_scaler 1 3>; // 1/3 慢速狙击
        };

        // 4. 你原本保留的 Tap-Dance 和 Home-row 行为保持原样
        test: test {
            compatible = "zmk,behavior-tap-dance";
            label = "TEST";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>, <&kp LEFT_ALT>;
        };

        alt_shift_dance: alt_shift_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_SHIFT_DANCE";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT BACKSPACE>, <&mt LEFT_SHIFT DEL>;
        };

        hml: homewrow_modes_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hmr: homewrow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    /* ===== [核心注入 2：全局层级监听器] 让不同图层拥有不同的轨迹球状态 ===== */
    // 先注释掉。
    /*
    // 默认基础状态：硬件默认的 600 CPI 原速移动
    &trackball {
        processors = <&zip_xy_scaler 1 1>;
    };

    // 分图层状态映射器：当键盘处于特定图层时，强制激活上面定义的特殊处理器
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        
        // 这一步是灵动的核心！
        // 当处于 Layer 1（层1），触发 ib_scroll（滚轮）
        // 当处于 Layer 2（层2），触发 ib_fast（加速）
        // 当处于 Layer 3（层3），触发 ib_sniper（狙击）
        bindings = <&ib_scroll>, <&ib_fast>, <&ib_sniper>;
        layers = <1 2 3>; 
    };
    */
    /* ==================================================================== */


    // 以下为你原封不动的 combos、macros 和图层配置

    combos {
        compatible = "zmk,combos";

        to2 {
            bindings = <&mo 2>;
            key-positions = <15 28>;
            layers = <0>;
            slow-release;
        };

        leftsmallbracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
        };

        rightsmallbracket {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        double-quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <25 26>;
            layers = <0>;
        };

        single-quotation {
            bindings = <&kp SQT>;
            key-positions = <33 34>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <37 38>;
        };

        slash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <21 20>;
        };

        S_slash {
            bindings = <&kp PIPE>;
            key-positions = <21 22>;
        };

        leftsquarebracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <27 28>;
            layers = <0>;
        };

        rightsquarebracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        bigleft {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <39 40>;
            layers = <0>;
        };

        bigright {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <43 44>;
        };

        tog2 {
            bindings = <&tog 2>;
            key-positions = <27 16>;
            slow-release;
            layers = <0>;
        };

        mo-2 {
            bindings = <&mo 2>;
            key-positions = <45 46>;
            layers = <0 3>;
        };
    };

    macros {
        copy_file_name: copy_file_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kp RC(C) &kp ESC>;
            label = "COPY_FILE_NAME";
        };

        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };


keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC         &kp N1             &kp N2        &kp N3     &kp N4            &kp N5         &kp N6       &kp N7         &kp N8     &kp N9        &kp N0                      &kp BACKSPACE
&kp TAB         &kp Q              &kp W         &kp E      &kp R             &kp T          &kp Y        &kp U          &kp I      &kp O         &kp P                       &kp BSLH
&kp LEFT_SHIFT  &hml LEFT_SHIFT A  &hml LCTRL S  &kp D      &kp F             &kp G          &kp H        &kp J          &kp K      &hml RCTRL L  &hmr RIGHT_SHIFT SEMICOLON  &kp ENTER
&kp LEFT_WIN    &hml LEFT_WIN Z    &kp X         &kp C      &kp V             &kp B          &kp N        &kp M          &kp COMMA  &kp PERIOD    &hmr RWIN SLASH             &kp RIGHT_SHIFT
                                                 &kp LCTRL  &alt_shift_dance  &lt 1 SPACE    &lt 1 SPACE  &kp RIGHT_ALT
                                                            &mkp MB1          &mkp MB2       &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp ESC         &kp F1    &kp F2         &kp F3        &kp F4           &kp F5      &kp F6           &kp F7         &kp F8    &kp F9            &kp F10            &kp DEL
&kp GRAVE       &kp HOME  &kp PAGE_UP    &test         &none            &none       &none            &none          &kp UP    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&kp LEFT_SHIFT  &kp END   &kp PAGE_DOWN  &none         &copy_file_name  &none       &kp TAB          &kp LEFT       &kp DOWN  &kp RIGHT         &kp SQT            &kp ENTER
&kp LCTRL       &none     &mo 3          &mo 2         &kp BACKSPACE    &kp DEL     &kp ESCAPE       &none          &kp F11   &kp MINUS         &kp EQUAL          &kp RIGHT_SHIFT
                                         &kp LEFT_ALT  &kp SPACE        &to 0       &kp RIGHT_SHIFT  &kp RIGHT_ALT
                                                       &mkp MB1         &mkp MB2    &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&trans     &trans  &trans  &trans  &trans    &trans        &trans  &trans    &trans    &trans    &trans  &trans
&trans     &trans  &trans  &trans  &trans    &bt BT_NXT    &trans  &trans    &trans    &trans    &trans  &trans
&trans     &trans  &trans  &trans  &none     &bt BT_CLR    &trans  &trans    &trans    &trans    &trans  &trans
&kp LCTRL  &trans  &kp X   &kp C   &kp V     &kp B         &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
                           &trans  &mkp MB3  &to 0         &trans  &trans
                                   &mkp MB1  &mkp MB2      &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &to 0          &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
                        &trans  &mkp MB3  &lt 1 SPACE    &trans  &trans
                                &mkp MB1  &mkp MB2       &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_NXT  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans    &trans  &trans
                                    &trans  &trans    &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&dpi_low        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };

};
