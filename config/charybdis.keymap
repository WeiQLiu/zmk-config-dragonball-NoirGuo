#include <dt-bindings/zmk/mouse.h>

// 🌟 必须确保有这两行

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    /*
     * 轨迹球自动鼠标层（带位移门限）。
     *
     * param1 = 目标层（3 = mouse），param2 = 无操作后回落时间（400ms）。
     *
     * activation-threshold：需要累计移动多少个计数才进入鼠标层。
     *   trackball 已设为 1200 CPI，再经下面 zip_xy_scaler 1/4 还原成
     *   300 CPI，和没有 dongle 时的手感一致；此时 30 counts ≈ 2.5mm。
     * activation-window-ms：这些位移必须在 300ms 内累计完成，
     *   否则清零，避免缓慢漂移慢慢凑够阈值。
     */
    mouse_layer_gate: mouse_layer_gate {
        compatible = "zmk,input-processor-mouse-layer-gate";
        #input-processor-cells = <2>;
        // activation-threshold = <30>; // 30 约等于2.5mm 放大四倍左右吧。
        activation-threshold = <120>; // 120 约等于10 mm，轨迹球10mm以内的动不会发生变化。 

        activation-window-ms = <300>;
    };

    behaviors {
        test: test {
            compatible = "zmk,behavior-tap-dance";
            label = "TEST";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>, <&kp LEFT_ALT>;
        };

        alt_shift_dance: alt_shift_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ALT_SHIFT_DANCE";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT BACKSPACE>, <&mt LEFT_SHIFT DEL>;
        };

        hml: homewrow_modes_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hmr: homewrow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        to2 {
            bindings = <&mo 2>;
            key-positions = <15 28>;
            layers = <0>;
            slow-release;
        };

        leftsmallbracket {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
        };

        rightsmallbracket {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        double-quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <25 26>;
            layers = <0>;
        };

        single-quotation {
            bindings = <&kp SQT>;
            key-positions = <33 34>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <37 38>;
        };

        slash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <21 20>;
        };

        S_slash {
            bindings = <&kp PIPE>;
            key-positions = <21 22>;
        };

        leftsquarebracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <27 28>;
            layers = <0>;
        };

        rightsquarebracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 32>;
            layers = <0>;
        };

        bigleft {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <39 40>;
            layers = <0>;
        };

        bigright {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <43 44>;
        };

        tog2 {
            bindings = <&tog 2>;
            key-positions = <27 16>;
            slow-release;
            layers = <0>;
        };

        mo-2 {
            bindings = <&mo 2>;
            key-positions = <45 46>;
            layers = <0 3>;
        };
    };

    macros {
        copy_file_name: copy_file_name {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kp RC(C) &kp ESC>;
            label = "COPY_FILE_NAME";
        };

        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
        display-name = "base";
            bindings = <
&kp ESC         &kp N1             &kp N2        &kp N3     &kp N4            &kp N5         &kp N6       &kp N7         &kp N8       &kp N9        &kp N0                      &kp BSLH
&kp TAB         &kp Q              &kp W         &kp E      &kp R             &kp T          &kp Y        &kp U          &kp I        &kp O         &kp P                       &kp BACKSPACE
&kp LEFT_SHIFT  &hml LEFT_SHIFT A  &hml LCTRL S  &kp D      &kp F             &kp G          &kp H        &kp J          &kp K        &hml RCTRL L  &hmr RIGHT_SHIFT SEMICOLON  &kp ENTER
&kp LEFT_WIN    &hml LEFT_WIN Z    &kp X         &kp C      &kp V             &kp B          &kp N        &kp M          &lt 4 COMMA  &kp PERIOD    &hmr RWIN SLASH             &kp RIGHT_SHIFT
                                                 &kp LCTRL  &alt_shift_dance  &lt 1 SPACE    &lt 1 SPACE  &kp RIGHT_ALT
                                                            &mkp MB1          &mkp MB2       &kp RCTRL
            >;
        };

        layer_1 {
            display-name = "func";
            bindings = <
&kp ESC         &kp F1    &kp F2         &kp F3        &kp F4           &kp F5      &kp F6           &kp F7         &kp F8    &kp F9            &kp F10            &kp BSLH
&kp GRAVE       &kp HOME  &kp PAGE_UP    &test         &none            &none       &none            &none          &kp UP    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DEL
&kp LEFT_SHIFT  &kp END   &kp PAGE_DOWN  &none         &copy_file_name  &none       &kp TAB          &kp LEFT       &kp DOWN  &kp RIGHT         &kp SQT            &kp ENTER
&kp LCTRL       &none     &mo 3          &mo 2         &kp BACKSPACE    &kp DEL     &kp ESCAPE       &none          &kp F11   &kp MINUS         &kp EQUAL          &kp RIGHT_SHIFT
                                         &kp LEFT_ALT  &kp SPACE        &to 0       &kp RIGHT_SHIFT  &kp RIGHT_ALT
                                                       &mkp MB1         &mkp MB2    &kp RCTRL
            >;
        };

        layer_2 {
            display-name = "quick";
            bindings = <
&trans     &trans  &trans  &trans  &trans        &trans        &trans  &trans    &trans    &trans    &trans  &trans
&trans     &trans  &trans  &trans  &out OUT_TOG  &bt BT_NXT    &trans  &trans    &trans    &trans    &trans  &trans
&trans     &trans  &trans  &trans  &none         &bt BT_CLR    &trans  &trans    &trans    &trans    &trans  &trans
&kp LCTRL  &trans  &kp X   &kp C   &kp V         &kp B         &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
                           &trans  &mkp MB3      &to 0         &trans  &trans
                                   &mkp MB1      &mkp MB2      &trans
            >;
        };

        layer_3 {
            display-name = "mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans         &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans    &to 0          &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
                        &trans  &mkp MB3  &lt 1 SPACE    &trans  &trans
                                &mkp MB1  &mkp MB2       &trans
            >;
        };

        layer_4 {
            display-name = "slow";
            bindings = <
&bt BT_NXT  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans    &trans  &trans
                                    &trans  &trans    &trans
            >;
        };
    };
};

&trackball_listener {
    status = "okay";

    /*
     * 方向转换之后，先把 1200 CPI 的原始计数除以 4，得到 300 CPI。
     * 这和无 dongle 固件里 PMW3610_CPI=1200 + CPI_DIVIDOR=4 的输出
     * 完全一致，刷完如果觉得慢/快，只改这个 1/4 即可。
     * 最后用 mouse_layer_gate 代替原来的 zip_temp_layer：位移够了才
     * 进鼠标层，400ms 没有移动/按键就回落到原来的层。
     */
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_XY_SWAP)>,
        <&zip_xy_scaler 1 4>,
        <&mouse_layer_gate 3 400>;

    // 🌟 添加滚动配置
    scroll {
        layers = <1>;
        /* 滚动链不经过上面的 1/4 缩放，所以这里单独把 1200 CPI 还原成
         * 原来的 400 CPI（1/3），保持换 dongle 前的滚动速度不变。 */
        input-processors = <&zip_xy_transform ( INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_XY_SWAP)>, <&zip_xy_scaler 1 3>, <&zip_x_scaler 1 30>, <&zip_y_scaler 1 10> , <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 3>;
    };
};
